{
  "name": "neoshell",
  "private": true,
  "type": "module",
  "description": "neoshell — a Wayland desktop shell rendered via a C++/WPE host, driven by a TypeScript host on bun.",
  "workspaces": [
    "apps/host",
    "apps/extensions",
    "packages/surface",
    "packages/sdk",
    "packages/ui"
  ],
  "scripts": {
    "lint": "oxlint --type-aware; a=$?; eslint .; b=$?; exit $((a | b))",
    "lint:fix": "oxlint --type-aware --fix; eslint . --fix",
    "lint:ts": "oxlint --type-aware",
    "lint:svelte": "eslint ."
  },
  "devDependencies": {
    "@neoworks/lint-config": "link:@neoworks/lint-config",
    "@types/bun": "latest",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.23.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte-eslint-parser": "^1.8.1",
    "typescript-eslint": "^8.68.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
